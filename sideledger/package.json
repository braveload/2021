{
  "name": "sideledger",
  "version": "1.2.4",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3217",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3217",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "migrate": "node scripts/migrate.mjs",
    "vercel-build": "node scripts/wait-ci.mjs && npm run migrate && npm run build"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/papaparse": "5.3.16",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "pg": "8.16.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
